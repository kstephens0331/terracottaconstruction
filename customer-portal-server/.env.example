# Supabase (server-side service role - NEVER commit the real one)
SUPABASE_URL=https://ueocfvwdmvqvnkrszpza.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Resend (transactional email)
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=Terracotta Construction <quotes@terracottaconstruction.com>

# Where customer-triggered admin notifications go
ADMIN_NOTIFICATION_EMAIL=terracottaconstruction1@gmail.com

# URLs used in email CTAs
PUBLIC_SITE_URL=https://terracottaconstruction.com
CUSTOMER_PORTAL_URL=https://customer.terracottaconstruction.com
ADMIN_PORTAL_URL=https://admin.terracottaconstruction.com

# Server
PORT=5000
NODE_ENV=development

# Google Gemini (vision + estimation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Smart Estimate limits
MAX_PHOTOS=5
MAX_PHOTO_SIZE_MB=5
ESTIMATE_RATE_LIMIT_PER_HOUR=30
