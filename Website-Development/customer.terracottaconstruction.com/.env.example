# Copy this file to .env and fill in the actual values (do not commit .env)

# Supabase (Create React App requires the REACT_APP_ prefix for env vars exposed to the browser)
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# Customer portal backend (customer-portal-server). Used for revision requests
# and other server-side customer actions. Set to the deployed URL in production.
REACT_APP_BACKEND_URL=http://localhost:5000
